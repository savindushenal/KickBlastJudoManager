<Page x:Class="KickBlastJudoManager.Pages.CompetitionManagementPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:KickBlastJudoManager.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="600" d:DesignWidth="900"
      Title="Competition Management">

    <Grid Background="#F5F5F5">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="White" Padding="30,20" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
            <Grid>
                <TextBlock Text="Competition Management" FontSize="28" FontWeight="Bold" Foreground="#2C3E50" VerticalAlignment="Center"/>
                <Button x:Name="btnAddCompetition" Content="+ Register New Competition" 
                        Background="#3498DB" Foreground="White" 
                        Padding="20,12" FontSize="14" FontWeight="SemiBold"
                        BorderThickness="0" Cursor="Hand" 
                        HorizontalAlignment="Right"
                        Click="AddCompetition_Click"/>
            </Grid>
        </Border>

        <!-- Add Competition Form -->
        <Border x:Name="pnlAddForm" Grid.Row="1" Background="#ECF0F1" Padding="25" Margin="30,20,30,0" 
                BorderBrush="#BDC3C7" BorderThickness="1" CornerRadius="5" Visibility="Collapsed">
            <StackPanel>
                <TextBlock Text="Register New Competition" FontSize="18" FontWeight="Bold" Margin="0,0,0,15"/>
                
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                        <Label Content="Competition Name *" FontSize="12"/>
                        <TextBox x:Name="txtCompetitionName" Height="40" Padding="10" FontSize="14"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="0,0,10,0">
                        <Label Content="Date (2nd Saturday Only) *" FontSize="12"/>
                        <DatePicker x:Name="dpCompetitionDate" Height="40" Padding="10" FontSize="14"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Bottom">
                        <Button Content="Save" Width="100" Height="40" 
                                Background="#27AE60" Foreground="White" FontSize="14" FontWeight="SemiBold"
                                BorderThickness="0" Margin="0,0,5,0" Click="SaveCompetition_Click"/>
                        <Button Content="Cancel" Width="100" Height="40"
                                Background="#95A5A6" Foreground="White" FontSize="14" FontWeight="SemiBold"
                                BorderThickness="0" Click="CancelAdd_Click"/>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Competitions List -->
        <Border Grid.Row="2" Background="White" CornerRadius="8" Padding="25" Margin="30,20" BorderBrush="#E0E0E0" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Search -->
                <Grid Grid.Row="0" Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBox x:Name="txtSearch" Grid.Column="0" 
                             Padding="10" FontSize="14" 
                             BorderBrush="#BDC3C7" BorderThickness="1"
                             TextChanged="Search_TextChanged">
                        <TextBox.Style>
                            <Style TargetType="TextBox">
                                <Style.Triggers>
                                    <Trigger Property="Text" Value="">
                                        <Setter Property="Background">
                                            <Setter.Value>
                                                <VisualBrush AlignmentX="Left" AlignmentY="Center" Stretch="None">
                                                    <VisualBrush.Visual>
                                                        <TextBlock Text="Search competitions..." Foreground="#95A5A6" Margin="5,0,0,0"/>
                                                    </VisualBrush.Visual>
                                                </VisualBrush>
                                            </Setter.Value>
                                        </Setter>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </TextBox.Style>
                    </TextBox>

                    <Button x:Name="btnRefresh" Grid.Column="1" Content="&#xE72C;" 
                            FontFamily="Segoe MDL2 Assets" FontSize="16"
                            Background="#2ECC71" Foreground="White" 
                            Padding="15,10" Margin="10,0,0,0"
                            BorderThickness="0" Cursor="Hand"
                            Click="Refresh_Click"/>
                </Grid>

                <!-- DataGrid -->
                <DataGrid x:Name="dgCompetitions" Grid.Row="1" 
                          AutoGenerateColumns="False" 
                          CanUserAddRows="False" 
                          SelectionMode="Single"
                          IsReadOnly="True"
                          GridLinesVisibility="None"
                          HeadersVisibility="Column"
                          Background="White"
                          BorderThickness="0"
                          RowHeight="50"
                          AlternatingRowBackground="#F8F9FA">
                    
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Competition Name" Binding="{Binding CompetitionName}" Width="*" FontSize="14" FontWeight="SemiBold"/>
                        <DataGridTextColumn Header="Date" Binding="{Binding CompetitionDate, StringFormat='yyyy-MM-dd (dddd)'}" Width="200" FontSize="14"/>
                        <DataGridTextColumn Header="Entry Fee" Width="120" FontSize="14" Foreground="#27AE60" FontWeight="SemiBold">
                            <DataGridTextColumn.Binding>
                                <Binding StringFormat="Rs. 220.00"/>
                            </DataGridTextColumn.Binding>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Participants" Binding="{Binding ParticipantCount}" Width="120" FontSize="14" Foreground="#3498DB" FontWeight="SemiBold"/>
                        
                        <DataGridTemplateColumn Header="Actions" Width="220">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Button Content="Participants" Background="#3498DB" Foreground="White" 
                                                Padding="12,6" Margin="2" BorderThickness="0" Cursor="Hand"
                                                Tag="{Binding CompetitionId}" Click="ManageParticipants_Click"/>
                                        <Button Content="Delete" Background="#E74C3C" Foreground="White" 
                                                Padding="12,6" Margin="2" BorderThickness="0" Cursor="Hand"
                                                Tag="{Binding CompetitionId}" Click="DeleteCompetition_Click"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>
    </Grid>
</Page>
