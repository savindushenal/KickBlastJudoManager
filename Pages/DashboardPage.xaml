<Page x:Class="KickBlastJudoManager.Pages.DashboardPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      mc:Ignorable="d" 
      d:DesignHeight="600" d:DesignWidth="900"
      Title="Dashboard">

    <Grid Background="#F5F5F5">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="White" Padding="30,20" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
            <StackPanel>
                <TextBlock Text="Dashboard" FontSize="28" FontWeight="Bold" Foreground="#2C3E50"/>
                <TextBlock Text="KickBlast Judo Management System" FontSize="14" Foreground="#7F8C8D" Margin="0,5,0,0"/>
            </StackPanel>
        </Border>

        <!-- Content -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="30,20">
                <!-- Statistics Cards -->
                <TextBlock Text="Overview" FontSize="20" FontWeight="SemiBold" Foreground="#2C3E50" Margin="0,0,0,15"/>
                
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Total Athletes Card -->
                    <Border Grid.Column="0" Background="White" CornerRadius="8" Padding="20" Margin="0,0,10,0" BorderBrush="#E0E0E0" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="&#xE716;" FontFamily="Segoe MDL2 Assets" FontSize="32" Foreground="#3498DB" HorizontalAlignment="Left"/>
                            <TextBlock x:Name="txtTotalAthletes" Text="0" FontSize="32" FontWeight="Bold" Foreground="#2C3E50" Margin="0,10,0,0"/>
                            <TextBlock Text="Total Athletes" FontSize="14" Foreground="#7F8C8D"/>
                        </StackPanel>
                    </Border>

                    <!-- Beginner Athletes Card -->
                    <Border Grid.Column="1" Background="White" CornerRadius="8" Padding="20" Margin="5,0" BorderBrush="#E0E0E0" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="&#xE82F;" FontFamily="Segoe MDL2 Assets" FontSize="32" Foreground="#2ECC71" HorizontalAlignment="Left"/>
                            <TextBlock x:Name="txtBeginnerCount" Text="0" FontSize="32" FontWeight="Bold" Foreground="#2C3E50" Margin="0,10,0,0"/>
                            <TextBlock Text="Beginner" FontSize="14" Foreground="#7F8C8D"/>
                        </StackPanel>
                    </Border>

                    <!-- Intermediate Athletes Card -->
                    <Border Grid.Column="2" Background="White" CornerRadius="8" Padding="20" Margin="5,0" BorderBrush="#E0E0E0" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="&#xE734;" FontFamily="Segoe MDL2 Assets" FontSize="32" Foreground="#F39C12" HorizontalAlignment="Left"/>
                            <TextBlock x:Name="txtIntermediateCount" Text="0" FontSize="32" FontWeight="Bold" Foreground="#2C3E50" Margin="0,10,0,0"/>
                            <TextBlock Text="Intermediate" FontSize="14" Foreground="#7F8C8D"/>
                        </StackPanel>
                    </Border>

                    <!-- Elite Athletes Card -->
                    <Border Grid.Column="3" Background="White" CornerRadius="8" Padding="20" Margin="10,0,0,0" BorderBrush="#E0E0E0" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="&#xE735;" FontFamily="Segoe MDL2 Assets" FontSize="32" Foreground="#E74C3C" HorizontalAlignment="Left"/>
                            <TextBlock x:Name="txtEliteCount" Text="0" FontSize="32" FontWeight="Bold" Foreground="#2C3E50" Margin="0,10,0,0"/>
                            <TextBlock Text="Elite" FontSize="14" Foreground="#7F8C8D"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Quick Actions -->
                <TextBlock Text="Quick Actions" FontSize="20" FontWeight="SemiBold" Foreground="#2C3E50" Margin="0,30,0,15"/>
                
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Button x:Name="btnAddAthlete" Grid.Column="0"
                            Background="#3498DB" Foreground="White" 
                            Padding="20,15" Margin="0,0,10,0" BorderThickness="0" 
                            Cursor="Hand" Click="AddAthlete_Click">
                        <Button.Content>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="16" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <TextBlock Text="Add New Athlete" FontSize="14" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button.Content>
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="#3498DB"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#2980B9"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <Button x:Name="btnViewRecords" Grid.Column="1"
                            Background="#2ECC71" Foreground="White" 
                            Padding="20,15" Margin="5,0" BorderThickness="0" 
                            Cursor="Hand" Click="ViewRecords_Click">
                        <Button.Content>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8F1;" FontFamily="Segoe MDL2 Assets" FontSize="16" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <TextBlock Text="View All Records" FontSize="14" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button.Content>
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="#2ECC71"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#27AE60"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <Button x:Name="btnCalculateCost" Grid.Column="2"
                            Background="#F39C12" Foreground="White" 
                            Padding="20,15" Margin="10,0,0,0" BorderThickness="0" 
                            Cursor="Hand" Click="CalculateCost_Click">
                        <Button.Content>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8A0;" FontFamily="Segoe MDL2 Assets" FontSize="16" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <TextBlock Text="Calculate Cost" FontSize="14" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button.Content>
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="#F39C12"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#E67E22"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>

                <!-- Recent Athletes -->
                <TextBlock Text="Recent Athletes" FontSize="20" FontWeight="SemiBold" Foreground="#2C3E50" Margin="0,30,0,15"/>
                
                <Border Background="White" CornerRadius="8" Padding="20" BorderBrush="#E0E0E0" BorderThickness="1">
                    <DataGrid x:Name="dgRecentAthletes" 
                              AutoGenerateColumns="False" 
                              IsReadOnly="True"
                              HeadersVisibility="Column"
                              GridLinesVisibility="None"
                              Background="White"
                              RowBackground="White"
                              AlternatingRowBackground="#F9F9F9"
                              BorderThickness="0"
                              CanUserAddRows="False"
                              SelectionMode="Single">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Name" Binding="{Binding AthleteName}" Width="*"/>
                            <DataGridTextColumn Header="Plan" Binding="{Binding TrainingPlanName}" Width="120"/>
                            <DataGridTextColumn Header="Weight" Binding="{Binding CurrentWeight, StringFormat={}{0} kg}" Width="80"/>
                            <DataGridTextColumn Header="Category" Binding="{Binding WeightCategoryName}" Width="150"/>
                            <DataGridTextColumn Header="Monthly Cost" Binding="{Binding MonthlyCost, StringFormat=Rs. {0:F2}}" Width="120"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
