<Page x:Class="KickBlastJudoManager.Pages.CalculateCostPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      mc:Ignorable="d" 
      d:DesignHeight="600" d:DesignWidth="900"
      Title="Calculate Monthly Cost">

    <Grid Background="#F5F5F5">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="White" Padding="30,20" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
            <TextBlock Text="Calculate Monthly Cost" FontSize="28" FontWeight="Bold" Foreground="#2C3E50" VerticalAlignment="Center"/>
        </Border>

        <!-- Content -->
        <Border Grid.Row="1" Background="White" CornerRadius="8" Padding="40" Margin="30,20" BorderBrush="#E0E0E0" BorderThickness="1">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel MaxWidth="600">
                    <!-- Select Athlete -->
                    <TextBlock Text="Select Athlete *" FontSize="16" FontWeight="SemiBold" Foreground="#34495E" Margin="0,0,0,8"/>
                    <ComboBox x:Name="cmbAthlete" Height="45" Padding="12" FontSize="14" 
                              BorderBrush="#BDC3C7" BorderThickness="1" Margin="0,0,0,25"
                              DisplayMemberPath="AthleteName" SelectionChanged="Athlete_SelectionChanged"/>

                    <!-- Athlete Info Display -->
                    <Border x:Name="pnlAthleteInfo" Background="#ECF0F1" Padding="20" CornerRadius="5" Margin="0,0,0,25" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock x:Name="txtAthleteInfo" TextWrapping="Wrap" FontSize="14" Foreground="#2C3E50"/>
                        </StackPanel>
                    </Border>

                    <!-- Number of Competitions -->
                    <TextBlock Text="Number of Competitions Entered *" FontSize="16" FontWeight="SemiBold" Foreground="#34495E" Margin="0,0,0,8"/>
                    <TextBox x:Name="txtCompetitions" Height="45" Padding="12" FontSize="14" 
                             BorderBrush="#BDC3C7" BorderThickness="1" Margin="0,0,0,5"
                             Text="0"/>
                    <TextBlock Text="Fee: Rs. 220.00 per competition" FontSize="12" Foreground="#7F8C8D" Margin="0,0,0,25"/>

                    <!-- Private Coaching Hours -->
                    <TextBlock Text="Private Coaching Hours (Max 5 per week) *" FontSize="16" FontWeight="SemiBold" Foreground="#34495E" Margin="0,0,0,8"/>
                    <TextBox x:Name="txtCoachingHours" Height="45" Padding="12" FontSize="14" 
                             BorderBrush="#BDC3C7" BorderThickness="1" Margin="0,0,0,5"
                             Text="0"/>
                    <TextBlock Text="Rate: Rs. 90.50 per hour | Max: 20 hours per month (4 weeks × 5 hours)" 
                               FontSize="12" Foreground="#7F8C8D" Margin="0,0,0,25"/>

                    <!-- Buttons -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
                        <Button x:Name="btnCalculate" Content="Calculate Monthly Cost" 
                                Background="#3498DB" Foreground="White" 
                                Padding="30,15" FontSize="16" FontWeight="Bold"
                                BorderThickness="0" Cursor="Hand" Margin="0,0,15,0"
                                Click="Calculate_Click"/>
                        
                        <Button x:Name="btnClear" Content="Clear" 
                                Background="#95A5A6" Foreground="White" 
                                Padding="30,15" FontSize="16" FontWeight="SemiBold"
                                BorderThickness="0" Cursor="Hand"
                                Click="Clear_Click"/>
                    </StackPanel>

                    <!-- Result Display -->
                    <Border x:Name="pnlResult" Background="#D5F4E6" BorderBrush="#27AE60" BorderThickness="2" 
                            Padding="25" CornerRadius="8" Margin="0,30,0,0" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock Text="Monthly Cost Breakdown" FontSize="18" FontWeight="Bold" 
                                       Foreground="#27AE60" HorizontalAlignment="Center" Margin="0,0,0,15"/>
                            <TextBlock x:Name="txtResult" TextWrapping="Wrap" FontSize="14" 
                                       Foreground="#2C3E50" LineHeight="22"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</Page>
