<Page x:Class="KickBlastJudoManager.Pages.ViewRecordsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      mc:Ignorable="d" 
      d:DesignHeight="600" d:DesignWidth="900"
      Title="View Records">

    <Grid Background="#F5F5F5">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="White" Padding="30,20" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <TextBlock Grid.Column="0" Text="View All Records" FontSize="28" FontWeight="Bold" Foreground="#2C3E50" VerticalAlignment="Center"/>
                
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <TextBox x:Name="txtSearch" Width="250" Padding="10" FontSize="14" 
                             BorderBrush="#BDC3C7" BorderThickness="1" Margin="0,0,10,0"
                             TextChanged="Search_TextChanged">
                        <TextBox.Style>
                            <Style TargetType="TextBox">
                                <Style.Triggers>
                                    <Trigger Property="Text" Value="">
                                        <Setter Property="Background">
                                            <Setter.Value>
                                                <VisualBrush Stretch="None" AlignmentX="Left">
                                                    <VisualBrush.Visual>
                                                        <TextBlock Text="🔍 Search athletes..." Foreground="#95A5A6" Margin="5,0,0,0"/>
                                                    </VisualBrush.Visual>
                                                </VisualBrush>
                                            </Setter.Value>
                                        </Setter>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </TextBox.Style>
                    </TextBox>
                    
                    <Button Content="&#xE72C; Refresh" 
                            FontFamily="Segoe MDL2 Assets, Segoe UI" FontSize="12"
                            Background="#3498DB" Foreground="White" 
                            Padding="15,8" BorderThickness="0" Cursor="Hand"
                            Click="Refresh_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Content -->
        <Grid Grid.Row="1" Margin="30,20">
            <Border Background="White" CornerRadius="8" Padding="25" BorderBrush="#E0E0E0" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Filter Options -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,15">
                        <TextBlock Text="Filter by Plan:" FontWeight="SemiBold" Foreground="#34495E" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <ComboBox x:Name="cmbFilterPlan" Width="150" Padding="8" FontSize="13"
                                  SelectionChanged="FilterPlan_SelectionChanged">
                            <ComboBoxItem Content="All Plans" IsSelected="True"/>
                            <ComboBoxItem Content="Beginner"/>
                            <ComboBoxItem Content="Intermediate"/>
                            <ComboBoxItem Content="Elite"/>
                        </ComboBox>
                    </StackPanel>

                    <!-- DataGrid -->
                    <DataGrid Grid.Row="1" x:Name="dgAllAthletes" 
                              AutoGenerateColumns="False" 
                              IsReadOnly="True"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              Background="White"
                              RowBackground="White"
                              AlternatingRowBackground="#F9F9F9"
                              BorderThickness="0"
                              CanUserAddRows="False"
                              SelectionMode="Single"
                              RowHeight="35">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="50"/>
                            <DataGridTextColumn Header="Athlete Name" Binding="{Binding AthleteName}" Width="*"/>
                            <DataGridTextColumn Header="Training Plan" Binding="{Binding TrainingPlanName}" Width="120"/>
                            <DataGridTextColumn Header="Current Weight" Binding="{Binding CurrentWeight, StringFormat={}{0} kg}" Width="120"/>
                            <DataGridTextColumn Header="Weight Category" Binding="{Binding WeightCategoryName}" Width="150"/>
                            <DataGridTextColumn Header="Competitions" Binding="{Binding CompetitionsEntered}" Width="100"/>
                            <DataGridTextColumn Header="Private Hours" Binding="{Binding PrivateCoachingHours}" Width="100"/>
                            <DataGridTextColumn Header="Monthly Cost" Binding="{Binding MonthlyCost, StringFormat=Rs. {0:F2}}" Width="120"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
