<Page x:Class="KickBlastJudoManager.Pages.ManageAthletesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      mc:Ignorable="d" 
      d:DesignHeight="600" d:DesignWidth="900"
      Title="Manage Athletes">

    <Grid Background="#F5F5F5">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="White" Padding="30,20" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
            <Grid>
                <TextBlock Text="Manage Athletes" FontSize="28" FontWeight="Bold" Foreground="#2C3E50" VerticalAlignment="Center"/>
                <Button x:Name="btnAddNewAthlete" Content="+ Add New Athlete" 
                        Background="#3498DB" Foreground="White" 
                        Padding="20,12" FontSize="14" FontWeight="SemiBold"
                        BorderThickness="0" Cursor="Hand" 
                        HorizontalAlignment="Right"
                        Click="AddNewAthlete_Click"/>
            </Grid>
        </Border>

        <!-- Content -->
        <Border Grid.Row="1" Background="White" CornerRadius="8" Padding="25" Margin="30,20" BorderBrush="#E0E0E0" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Search/Filter -->
                <Grid Grid.Row="0" Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBox x:Name="txtSearch" Grid.Column="0" 
                             Padding="10" FontSize="14" 
                             BorderBrush="#BDC3C7" BorderThickness="1"
                             TextChanged="Search_TextChanged">
                        <TextBox.Style>
                            <Style TargetType="TextBox">
                                <Style.Triggers>
                                    <Trigger Property="Text" Value="">
                                        <Setter Property="Background">
                                            <Setter.Value>
                                                <VisualBrush AlignmentX="Left" AlignmentY="Center" Stretch="None">
                                                    <VisualBrush.Visual>
                                                        <TextBlock Text="Search athletes..." Foreground="#95A5A6" Margin="5,0,0,0"/>
                                                    </VisualBrush.Visual>
                                                </VisualBrush>
                                            </Setter.Value>
                                        </Setter>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </TextBox.Style>
                    </TextBox>

                    <Button x:Name="btnRefresh" Grid.Column="1" Content="&#xE72C;" 
                            FontFamily="Segoe MDL2 Assets" FontSize="16"
                            Background="#2ECC71" Foreground="White" 
                            Padding="15,10" Margin="10,0,0,0"
                            BorderThickness="0" Cursor="Hand"
                            Click="Refresh_Click"/>
                </Grid>

                <!-- Athletes DataGrid -->
                <DataGrid x:Name="dgAthletes" Grid.Row="1" 
                          AutoGenerateColumns="False" 
                          CanUserAddRows="False" 
                          SelectionMode="Single"
                          IsReadOnly="True"
                          GridLinesVisibility="None"
                          HeadersVisibility="Column"
                          Background="White"
                          BorderThickness="0"
                          RowHeight="50"
                          AlternatingRowBackground="#F8F9FA"
                          SelectionChanged="DataGrid_SelectionChanged">
                    
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Name" Binding="{Binding AthleteName}" Width="*" FontSize="14"/>
                        <DataGridTextColumn Header="Training Plan" Binding="{Binding TrainingPlanName}" Width="150" FontSize="14"/>
                        <DataGridTextColumn Header="Weight (kg)" Binding="{Binding CurrentWeight, StringFormat=F1}" Width="100" FontSize="14"/>
                        <DataGridTextColumn Header="Category" Binding="{Binding WeightCategoryName}" Width="180" FontSize="14"/>
                        
                        <DataGridTemplateColumn Header="Actions" Width="150">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Button Content="Edit" Background="#3498DB" Foreground="White" 
                                                Padding="15,6" Margin="2" BorderThickness="0" Cursor="Hand"
                                                Tag="{Binding AthleteId}" Click="EditAthlete_Click"/>
                                        <Button Content="Delete" Background="#E74C3C" Foreground="White" 
                                                Padding="15,6" Margin="2" BorderThickness="0" Cursor="Hand"
                                                Tag="{Binding AthleteId}" Click="DeleteAthlete_Click"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>
    </Grid>
</Page>
