<Window x:Class="KickBlastJudoManager.Dialogs.CompetitionsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Manage Competitions" 
        Height="500" 
        Width="700"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="#F5F5F5">

    <Window.Resources>
        <Style TargetType="Button" x:Key="ActionButton">
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Margin" Value="5,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Grid.Row="0" x:Name="txtHeader" Text="Competitions for Athlete" 
                   FontSize="20" FontWeight="Bold" Margin="0,0,0,20"/>

        <!-- Add Competition Section -->
        <Border Grid.Row="1" Background="White" Padding="15" Margin="0,0,0,15" CornerRadius="5">
            <StackPanel>
                <TextBlock Text="Add New Competition" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                        <Label Content="Competition Name *" FontSize="12"/>
                        <TextBox x:Name="txtCompetitionName" Height="35" Padding="8" FontSize="14"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="0,0,10,0">
                        <Label Content="Date *" FontSize="12"/>
                        <DatePicker x:Name="dpCompetitionDate" Height="35" Padding="8" FontSize="14"/>
                    </StackPanel>

                    <Button x:Name="btnAddCompetition" Grid.Column="2" Content="Add" Width="100" Height="35" Margin="0,22,0,0"
                            Background="#007BFF" Foreground="White" FontSize="14" FontWeight="SemiBold" 
                            BorderThickness="0" Click="AddCompetition_Click"/>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Competitions List -->
        <Border Grid.Row="2" Background="White" CornerRadius="5">
            <DataGrid x:Name="dgCompetitions" AutoGenerateColumns="False" 
                      CanUserAddRows="False" CanUserDeleteRows="False"
                      HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                      BorderThickness="0" Background="White"
                      AlternatingRowBackground="#F8F9FA">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Competition Name" Binding="{Binding CompetitionName}" Width="*" IsReadOnly="True">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="Padding" Value="10"/>
                                <Setter Property="FontSize" Value="14"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Date" Binding="{Binding CompetitionDate, StringFormat='yyyy-MM-dd'}" Width="150" IsReadOnly="True">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="Padding" Value="10"/>
                                <Setter Property="FontSize" Value="14"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Fee" Width="100" IsReadOnly="True">
                        <DataGridTextColumn.Binding>
                            <Binding StringFormat="Rs. 220.00"/>
                        </DataGridTextColumn.Binding>
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="Padding" Value="10"/>
                                <Setter Property="FontSize" Value="14"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTemplateColumn Header="Actions" Width="100">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="Delete" Tag="{Binding CompetitionId}"
                                        Background="#DC3545" Style="{StaticResource ActionButton}"
                                        Click="DeleteCompetition_Click"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Total and Close -->
        <Grid Grid.Row="3" Margin="0,15,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <TextBlock Text="Total Competitions: " FontSize="16" FontWeight="SemiBold"/>
                <TextBlock x:Name="txtTotalCount" Text="0" FontSize="16" FontWeight="Bold" Foreground="#007BFF" Margin="5,0,20,0"/>
                <TextBlock Text="Total Cost: " FontSize="16" FontWeight="SemiBold"/>
                <TextBlock x:Name="txtTotalCost" Text="Rs. 0.00" FontSize="16" FontWeight="Bold" Foreground="#28A745" Margin="5,0,0,0"/>
            </StackPanel>
            <Button Content="Close" Width="100" Height="40" HorizontalAlignment="Right"
                    Background="#6C757D" Foreground="White" FontSize="14" FontWeight="SemiBold" 
                    BorderThickness="0" Click="Close_Click"/>
        </Grid>
    </Grid>
</Window>
